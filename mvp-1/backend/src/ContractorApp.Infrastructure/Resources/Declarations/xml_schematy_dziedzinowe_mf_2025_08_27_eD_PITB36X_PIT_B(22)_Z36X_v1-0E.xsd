<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:zb36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36X/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36X/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznań: PIT-36S, PIT-36L i PIT-36LS.-->
	<xsd:complexType name="TNaglowek_PIT_B">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zb36x:TKodFormularza_PIT_B">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/B (22)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="22"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_B">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/B"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TUdzial">
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="9"/>
			<xsd:fractionDigits value="6"/>
			<xsd:minInclusive value="0"/>
			<xsd:maxInclusive value="100"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_B">
		<xsd:annotation>
			<xsd:documentation>Informacja o wysokości dochodu (straty) z pozarolniczej działalności gospodarczej za rok podatkowy</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zb36x:TNaglowek_PIT_B"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Przychody, koszty i dochody / straty z pozarolniczej działalności gospodarczej, zwanej dalej „działalnością gospodarczą”, przychody, koszty i dochody / straty w spółce niebędącej osobą prawną, w której podatnik jest wspólnikiem, Łączne przychody, koszty, dochód lub strata podatnika z działalności gospodarczej, Przychody oraz koszty uzyskania przychodów osiągnięte / poniesione w okresie zawieszenia wykonywania działalności gospodarczej, Przychody osiągnięte z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz koszty uzyskania tych przychodów, Składki na ubezpieczenia społeczne podatnika oraz osób z nim współpracujących, zaliczone do kosztów uzyskania przychodów, Informacja o okresie zawieszenia wykonywania działalności gospodarczej prowadzonej w formie spółki (spółek) w roku podatkowym</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--B. Przychody, koszty i dochody / straty z pozarolniczej działalności gospodarczej, zwanej dalej „działalnością gospodarczą”-->
							<!-- -->
							<!--Jeżeli podatnik wykonuje różne rodzaje działalności lub wykonuje działalność w wielu miejscach i zgodnie z przepisami w sprawie prowadzenia podatkowej księgi przychodów i rozchodów (ksiąg rachunkowych) zdarzenia gospodarcze ujmuje w więcej niż w jednej księdze – w części B wykazuje łączne przychody, koszty i dochody (straty).-->
							<!-- -->
							<!--Podatnik nie wykazuje przypadających na niego przychodów, kosztów, dochodów / strat:
- z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie zezwolenia, o którym mowa w art. 16 ust. 1 ustawy 
z dnia 20 października 1994 r. o specjalnych strefach ekonomicznych, lub na podstawie decyzji o wsparciu wydanej zgodnie z przepisami ustawy z dnia 10 maja 2018 
r. o wspieraniu nowych inwestycji, które wykazuje w załączniku PIT/SE,
- z działalności gospodarczej prowadzonej za granicą, o których mowa w art. 27 ust. 8 ustawy,
- które wykazuje w załączniku PIT/IP,
- zwolnionych na podstawie art. 21 ust. 1 pkt 152-154 ustawy.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Przychody, koszty i dochody / straty z pozarolniczej działalności gospodarczej, zwanej dalej „działalnością gospodarczą”</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_7" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:choice>
									<xsd:element name="P_9" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_10" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:choice>
							</xsd:sequence>
							<!--C. Przychody, koszty i dochody / straty w spółce niebędącej osobą prawną, w której podatnik jest wspólnikiem-->
							<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Przychody, koszty i dochody / straty w spółce niebędącej osobą prawną, w której podatnik jest wspólnikiem</xsd:documentation>
								</xsd:annotation>
							<!--Podatnik nie wykazuje przypadających na niego przychodów, kosztów, dochodów / strat:
- z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie zezwolenia, o którym mowa w art. 16 ust. 1 ustawy 
z dnia 20 października 1994 r. o specjalnych strefach ekonomicznych, lub na podstawie decyzji o wsparciu wydanej zgodnie z przepisami ustawy z dnia 10 maja 2018 
r. o wspieraniu nowych inwestycji, które wykazuje w załączniku PIT/SE,
- z działalności gospodarczej prowadzonej za granicą, o których mowa w art. 27 ust. 8 ustawy,
- które wykazuje w załączniku PIT/IP,
- zwolnionych na podstawie art. 21 ust. 1 pkt 152-154 ustawy.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Dane dotyczące spółki</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_C11" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Nazwa spółki</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C12" type="zb36x:TUdzial">
											<xsd:annotation>
												<xsd:documentation>Udział podatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C13" type="etd:TNrNIP" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C14" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód spółki</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C15" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód przypadający na podatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C16" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodu spółki</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C17" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodu przypadające na podatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:sequence>
											<xsd:sequence minOccurs="0">
												<xsd:element name="P_C18" type="etd:TKwota2Nieujemna">
													<xsd:annotation>
														<xsd:documentation>Dochód spółki</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C19" type="etd:TKwota2Nieujemna">
													<xsd:annotation>
														<xsd:documentation>Dochód przypadający na podatnika</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
											<xsd:sequence minOccurs="0">
												<xsd:element name="P_C20" type="etd:TKwota2Nieujemna">
													<xsd:annotation>
														<xsd:documentation>Strata spółki</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C21" type="etd:TKwota2Nieujemna">
													<xsd:annotation>
														<xsd:documentation>Strata przypadająca na podatnika</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
											</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<!--D. Łączne przychody, koszty, dochód lub strata podatnika z działalności gospodarczej-->
							<!-- -->
							<!--Podatnik nie wykazuje przypadających na niego przychodów, kosztów, dochodów / strat:
- z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie zezwolenia, o którym mowa w art. 16 ust. 1 ustawy 
z dnia 20 października 1994 r. o specjalnych strefach ekonomicznych, lub na podstawie decyzji o wsparciu wydanej zgodnie z przepisami ustawy z dnia 10 maja 2018 
r. o wspieraniu nowych inwestycji, które wykazuje w załączniku PIT/SE,
- z działalności gospodarczej prowadzonej za granicą, o których mowa w art. 27 ust. 8 ustawy,
- które wykazuje w załączniku PIT/IP,
- zwolnionych na podstawie art. 21 ust. 1 pkt 152-154 ustawy.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Łączne przychody, koszty, dochód lub strata podatnika z działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychody</xsd:documentation>
									</xsd:annotation>
									<!--Suma kwot z poz. 7 i 15-->
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
									<!--Suma kwot z poz. 8 i 17-->
								</xsd:element>
								<xsd:choice>
									<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:choice>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Zwiększenia dochodu / zmniejszenia straty z działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód z kwalifikowanych praw własności intelektualnej niepodlegający opodatkowaniu na podstawie art. 30ca ust. 1 ustawy, tj. wg stawki 5%</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:choice>
									<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata po zmniejszeniu</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty z poz. 25 należy odjąć kwotę z poz. 26; jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
									<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód podlegający doliczeniu</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty z poz. 26 należy odjąć kwotę z poz. 25; jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
								</xsd:choice>
								<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Dochód po doliczeniu</xsd:documentation>
									</xsd:annotation>
									<!--Do kwoty z poz. 24 należy dodać kwotę z poz. 28.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Łączne przychody, koszty, dochód lub strata podatnika z działalności gospodarczej po doliczeniu</xsd:documentation>
								</xsd:annotation>
								<!--W poz. 30 i 31 należy wpisać odpowiednio kwoty z poz. 22 i 23, natomiast w poz. 32 i 33 odpowiednio kwoty z poz. 29 i 27.-->
								<!-- -->
								<!--Kwoty wynikające z poz. od 30 do 33 należy wpisać odpowiednio do wiersza nr 3 w części E.1. lub wiersza nr 3 w części E.2. zeznania PIT-36 albo do części D zeznania PIT-36S, albo do wiersza nr 1 w części E zeznania PIT-36L, albo do części D zeznania PIT-36LS, a jeżeli podatnik wypełnia informację PIT/Z – do części B.1. albo do części C.1. tej informacji.-->
								<xsd:sequence>
									<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody oraz koszty uzyskania przychodów osiągnięte / poniesione w okresie zawieszenia wykonywania działalności gospodarczej. Przychody</xsd:documentation>
										</xsd:annotation>
										<!--W tej części podatnik:
- nie wykazuje przychodów osiągniętych w okresie zawieszenia wykonywania działalności gospodarczej rozliczanych w tym okresie na podstawie art. 14c ustawy oraz kosztów uzyskania przychodów potrącanych w tym okresie na podstawie art. 22 ust. 4a i 4b ustawy,
- wykazuje również przychody osiągnięte w okresie zawieszenia wykonywania działalności gospodarczej oraz koszty uzyskania przychodów poniesione w tym okresie, z odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy.-->
										<!-- -->
										<!--W poz. 34 należy wykazać przychody ujęte w poz. 30, które zostały osiągnięte w okresie zawieszenia wykonywania działalności gospodarczej.-->
									</xsd:element>
								<!--F. Przychody osiągnięte z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz koszty uzyskania tych przychodów-->
								<!-- -->
								<!--W tej części podatnik nie wykazuje przychodów z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz kosztów uzyskania tych przychodów osiągniętych / poniesionych w okresie zawieszenia wykonywania działalności gospodarczej.-->
									<xsd:element name="P_36" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody osiągnięte z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz koszty uzyskania tych przychodów. Przychody</xsd:documentation>
										</xsd:annotation>
										<!--W poz. 36 należy wykazać przychody ujęte w poz. 30, które zostały osiągnięte z tytułu odpłatnego zbycia składników majątku.-->
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody oraz koszty uzyskania przychodów osiągnięte / poniesione w okresie zawieszenia wykonywania działalności gospodarczej. Koszty uzyskania przychodów</xsd:documentation>
										</xsd:annotation>
										<!--W tej części podatnik:
- nie wykazuje przychodów osiągniętych w okresie zawieszenia wykonywania działalności gospodarczej rozliczanych w tym okresie na podstawie art. 14c ustawy oraz kosztów uzyskania przychodów potrącanych w tym okresie na podstawie art. 22 ust. 4a i 4b ustawy,
- wykazuje również przychody osiągnięte w okresie zawieszenia wykonywania działalności gospodarczej oraz koszty uzyskania przychodów poniesione w tym okresie, z odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy.-->
										<!-- -->
										<!--W poz. 35 należy wykazać koszty uzyskania przychodów ujęte w poz. 31, które zostały poniesione w okresie zawieszenia wykonywania działalności gospodarczej.-->
									</xsd:element>
									<!--F. Przychody osiągnięte z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz koszty uzyskania tych przychodów-->
								<!-- -->
								<!--W tej części podatnik nie wykazuje przychodów z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz kosztów uzyskania tych przychodów osiągniętych / poniesionych w okresie zawieszenia wykonywania działalności gospodarczej.-->
									<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody osiągnięte z tytułu odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy oraz koszty uzyskania tych przychodów. Koszty uzyskania przychodów</xsd:documentation>
										</xsd:annotation>
										<!--W poz. 37 podatnik wpisuje koszty uzyskania przychodów, które uwzględnił w związku z odpłatnym zbyciem składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy.-->
										<!-- -->
										<!--W poz. 37 należy wykazać koszty uzyskania przychodów ujęte w poz. 31, które zostały poniesione z tytułu odpłatnego zbycia składników majątku.-->
									</xsd:element>
									<!--G. Składki na ubezpieczenia społeczne podatnika oraz osób z nim współpracujących, zaliczone do kosztów uzyskania przychodów-->
									<xsd:element name="P_38" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Nieodliczone od dochodu składki na ubezpieczenia społeczne podatnika oraz osób z nim współpracujących zaliczone do kosztów uzyskania przychodów</xsd:documentation>
										</xsd:annotation>
										<!--W poz. 38 należy wykazać składki na ubezpieczenia społeczne podatnika oraz osób z nim współpracujących, które zostały ujęte w poz. 31.-->
									</xsd:element>
								</xsd:sequence>
								<xsd:choice>
									<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:choice>
							</xsd:sequence>
							<!--H. Informacja o okresie zawieszenia wykonywania działalności gospodarczej prowadzonej w formie spółki (spółek) w roku podatkowym-->
							<!-- -->
							<!--Wypełnia wspólnik spółki jawnej lub partnerskiej, jeżeli spółka zawiesiła wykonywanie działalności gospodarczej. Należy wskazać nazwę pełną spółki, identyfikator NIP spółki oraz okresy zawieszenia wykonywania działalności gospodarczej w roku podatkowym.-->
							<xsd:element name="P_39" type="etd:TTekstowy" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o okresie zawieszenia wykonywania działalności gospodarczej prowadzonej w formie spółki (spółek) w roku podatkowym</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
