									<xsd:documentation>Strata z działów specjalnych produkcji rolnej po zmniejszeniach</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>G.2. Zwiększenia / zmniejszenia straty o wartość wierzytelności i zobowiązań wynikających z transakcji handlowych zawartych w ramach działalności gospodarczej</xsd:documentation>
