							<xsd:element name="P_137" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Suma wpłat dokonanych przez podatnika</xsd:documentation>
								</xsd:annotation>
								<!--Należy wpisać sumę kwot z poz. 129 i 136.-->
							</xsd:element>
							<xsd:element name="P_138" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Różnica między należnym podatkiem, o którym mowa w art. 30g ustawy, a podatkiem należnym</xsd:documentation>
								</xsd:annotation>
								<!--Od kwoty z poz. 122 należy odjąć kwotę z poz. 81. Jeżeli wynik jest liczbą ujemną, należy wpisać 0.-->
							</xsd:element>
							<xsd:element name="P_139" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Zryczałtowany podatek dochodowy, o którym mowa w art. 29, art. 30 i art. 30a ustawy, jeżeli podatek ten nie został pobrany przez płatnika, z wyjątkiem podatku wykazanego w poz. 140, 141 i w części M (po zaokrągleniu do pełnych złotych)</xsd:documentation>
								</xsd:annotation>
								<!--Zgodnie z art. 63 § 1a Ordynacji podatkowej, w przypadku zryczałtowanego podatku dochodowego, o którym mowa w art. 30a ust. 1 pkt 1-3 ustawy, kwotę należy zaokrąglić do pełnych groszy w górę.-->
							</xsd:element>
							<xsd:element name="P_140" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Zryczałtowany podatek obliczony od przychodów (dochodów), o których mowa w art. 30a ust. 1 pkt 1-5 ustawy, uzyskanych poza granicami Rzeczypospolitej Polskiej</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_141" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatek zapłacony za granicą, o którym mowa w art. 30a ust. 9 ustawy (przeliczony na złote)</xsd:documentation>
								</xsd:annotation>
								<!--Kwota z poz. 141 nie może przekroczyć kwoty z poz. 140.-->
							</xsd:element>
							<xsd:element name="P_142" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Różnica między zryczałtowanym podatkiem a podatkiem zapłaconym za granicą (po zaokrągleniu do pełnych złotych)</xsd:documentation>
								</xsd:annotation>
								<!--Zgodnie z art. 63 § 1a Ordynacji podatkowej, w przypadku zryczałtowanego podatku dochodowego, o którym mowa w art. 30a ust. 1 pkt 1-3 ustawy, kwotę należy zaokrąglić do pełnych groszy w górę.-->
								<!-- -->
								<!--Od kwoty z poz. 140 należy odjąć kwotę z poz. 141.-->
							</xsd:element>
							<xsd:element name="P_143" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatek wykazany w załączniku PIT/IP</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_144" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatek należny od dochodu wynikającego z uchylonej decyzji o wsparciu, jeżeli utrata prawa do zwolnienia nastąpiła w grudniu roku podatkowego oraz niezapłacony podatek należny od dochodu wynikającego z uchylonej decyzji o wsparciu, jeżeli utrata prawa do zwolnienia nastąpiła w innym miesiącu roku podatkowego, na podstawie art. 21 ust. 5c ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice>
								<xsd:element name="P_145" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>PODATEK DO ZAPŁATY</xsd:documentation>
									</xsd:annotation>
									<!--Od sumy kwot z poz. 81, 138, 139, 142, 143 i 144 należy odjąć kwotę z poz. 137. Jeżeli wynik jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
								<xsd:element name="P_146" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>NADPŁATA</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 137 należy odjąć sumę kwot z poz. 81, 138, 139, 142, 143 i 144. Jeżeli wynik jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
							</xsd:choice>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>M. Zryczałtowany podatek dochodowy, o którym mowa w art. 44 ust. 1b ustawy</xsd:documentation>
								</xsd:annotation>
								<!--Wypełniają osoby niemające miejsca zamieszkania na terytorium Rzeczypospolitej Polskiej uzyskujące przychody, o których mowa w art. 29 ustawy, bez pośrednictwa płatników.-->
								<xsd:element name="P_147" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_148" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_149" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc III</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_150" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kwota podatku - miesiąc IV</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_151" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc V</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_152" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc VI</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_153" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc VII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_154" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc VIII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_155" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc IX</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_156" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc X</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_157" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc XI</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_158" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatek - miesiąc XII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>N. Odsetki naliczone zgodnie z art. 22e ust. 1 pkt 4 i ust. 2 ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_159" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_160" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_161" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc III</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_162" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc IV</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_163" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc V</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_164" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc VI</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_165" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc VII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_166" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc VIII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_167" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc IX</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_168" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc X</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_169" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc XI</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_170" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odsetki - miesiąc XII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--O. Dochody (przychody) wykazywane na podstawie art. 45 ust. 3c ustawy-->
							<xsd:element name="P_171" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody (przychody) wykazywane na podstawie art. 45 ust. 3c ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>P. Wniosek o przekazanie 1,5% podatku należnego na rzecz Organizacji Pożytku Publicznego (OPP)</xsd:documentation>
								</xsd:annotation>
								<!--Należy podać numer wpisu do Krajowego Rejestru Sądowego (numer KRS) organizacji wybranej z wykazu prowadzonego na podstawie odrębnych przepisów oraz wysokość kwoty na jej rzecz. W poz. 174 można podać cel szczegółowy 1,5%, a zaznaczając kwadrat w poz. 175, wyrazić zgodę na przekazanie OPP swojego imienia, nazwiska i adresu wraz z informacją o kwocie z poz. 173.-->
								<xsd:element name="P_172" type="etd:TNrKRS">
									<xsd:annotation>
										<xsd:documentation>Numer KRS</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_173">
									<xsd:annotation>
										<xsd:documentation>Wnioskowana kwota</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:fractionDigits value="1"/>
										</xsd:restriction>
									</xsd:simpleType>
									<!--Kwota z poz. 173 nie może przekroczyć 1,5% kwoty z poz. 81, po zaokrągleniu do pełnych dziesiątek groszy w dół.-->
								</xsd:element>
								<xsd:element name="P_174" type="etd:TZnakowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Cel szczegółowy 1,5%</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_175" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wyrażam zgodę na przekazanie OPP swojego imienia, nazwiska i adresu wraz z informacją o kwocie z poz. 172</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--Q. Dane kontaktowe-->
							<!-- -->
							<!--W poz. 176 można podać numer telefonu, a w poz. 177 adres e-mail, ułatwiające kontakt z podatnikiem.-->
							<xsd:element name="P_176" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Telefon</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TZnakowy">
										<xsd:maxLength value="16"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_177" type="etd:TAdresEmail" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>E-mail</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--R. INFORMACJE O ZAŁĄCZNIKACH W poz. 178-188 należy podać liczbę załączników.-->
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_178" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/B</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_181" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/BR</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_183" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/Z</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_188" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/SE</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_179" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/IP</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_180" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/ZG</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_182" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/DS</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_184" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/PM</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_185" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/O</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_186" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/NZI</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_187" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/MIT</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_189" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/WOT</xsd:documentation>
								</xsd:annotation>
								</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>S. Rachunek osobisty do zwrotu nadpłaty</xsd:documentation>
								</xsd:annotation>
								<!--Jeżeli z zeznania wynika nadpłata, w tej części można wskazać rachunek bankowy lub rachunek w spółdzielczej kasie oszczędnościowo-kredytowej (SKOK), inny niż związany z prowadzoną działalnością gospodarczą, na który ma nastąpić jej zwrot. Podaje się rachunek, którego posiadaczem (współposiadaczem) jest podatnik. Wskazany rachunek aktualizuje poprzednio zgłoszony rachunek służący do zwrotu podatku lub nadpłaty. Można nie wpisywać rachunku, jeżeli zgłoszony poprzednio jest aktualny.-->
								<xsd:sequence minOccurs="0">
									<xsd:element name="P_190A" type="tns:TKodKrajuWydania">
										<xsd:annotation>
											<xsd:documentation>Kraj siedziby banku (oddziału)</xsd:documentation>
										</xsd:annotation>
										<!--uzupełnić wyłącznie, gdy wskazano rachunek zagraniczny-->
									</xsd:element>
									<xsd:element name="P_192_2" type="tns:SWIFT_Type">
										<xsd:annotation>
											<xsd:documentation>Kod SWIFT</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku rachunku zagranicznego należy podać kod SWIFT-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_191" type="kw:TKodWaluty" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Waluta, w której prowadzony jest rachunek</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_192_1" type="tns:TNrIBAN">
									<xsd:annotation>
										<xsd:documentation>Pełny numer rachunku - numer IBAN</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--T. KARTA DUŻEJ RODZINY (KDR)-->
							<xsd:element name="P_193" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik posiada ważną KDR: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:sequence minOccurs="0">
								<xsd:element ref="zb36x:Zalacznik_PIT_B"/>
								<xsd:element ref="zbr36x:Zalacznik_PIT_BR" minOccurs="0"/>
								<xsd:element ref="z36lx:Zalacznik_PIT_Z" minOccurs="0"/>
								<xsd:element ref="zse36x:Zalacznik_PIT_SE" minOccurs="0"/>
							</xsd:sequence>
							<xsd:element ref="zip36x:Zalacznik_PIT_IP" minOccurs="0"/>
							<xsd:element ref="zg36lx:Zalacznik_PIT_ZG" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zds36l:Zalacznik_PIT_DS" minOccurs="0"/>
							<xsd:element ref="zpm36x:Zalacznik_PIT_PM" minOccurs="0"/>
							<xsd:element ref="zo36lx:Zalacznik_PIT_O" minOccurs="0"/>
							<xsd:element ref="zzi36x:Zalacznik_PIT_NZI" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zmt36x:Zalacznik_PIT_MIT" minOccurs="0"/>
							<xsd:element ref="zwt:Zalacznik_PIT_WOT" minOccurs="0"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
W przypadku niewpłacenia w obowiązujących terminach należności z poz. 145 i 147-170 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, w tym również na odsetki od należności wykazanych w poz. 85-114, 116-121, 123-128 i 130-135, zgodnie z art. 3a § 1 pkt 1 ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji.</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>