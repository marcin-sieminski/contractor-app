										<xsd:documentation>Strata po zmniejszeniach - do odliczenia w kolejnych latach</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 58 należy odjąć kwotę z poz. 59. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
								<xsd:element name="P_61" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Doliczenie do podstawy obliczenia podatku</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 59 należy odjąć kwotę z poz. 58. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
