<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" xmlns:kw="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/" xmlns:kusex="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/" xmlns:tns="http://crd.gov.pl/wzor/2025/09/25/13874/" xmlns:zb36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36X/" xmlns:zbr36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITBR36X/" xmlns:zds36l="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITDS36L/" xmlns:zg36lx="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZG36LX/" xmlns:zip36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITIP36X/" xmlns:zmt36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITMIT36X/" xmlns:zo36lx="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO36LX/" xmlns:zpm36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITPM36X/" xmlns:zse36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITSE36X/" xmlns:zzi36x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITNZI36X/" xmlns:zwt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/" xmlns:z36lx="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZ36LX/" targetNamespace="http://crd.gov.pl/wzor/2025/09/25/13874/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36X/PIT_B(22)_Z36X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITIP36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITIP36X/PIT_IP(5)_Z36X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZG36LX/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZG36LX/PIT_ZG(8)_Z36LX_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITBR36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITBR36X/PIT_BR(7)_Z36X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITDS36L/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITDS36L/PIT_DS(6)_Z36L_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZ36LX/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/20/eD/PITZ36LX/PIT_Z(11)_Z36LX_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITPM36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITPM36X/PIT_PM(1)_Z36X_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO36LX/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO36LX/PIT_O(30)_Z36LX_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITNZI36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITNZI36X/PIT_NZI(1)_Z36X_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITMIT36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITMIT36X/PIT_MIT(2)_Z36X_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITSE36X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/11/06/eD/PITSE36X/PIT_SE(4)_Z36X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/PIT_WOT(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/ORD-ZU(3)_v10-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/KodyUrzedowSkarbowychExWUS_v8-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/KodyKrajow_v13-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/KodyWalut_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT36L (21)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="PPL"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="21"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_6"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Rok">
				<xsd:simpleType>
					<xsd:restriction base="etd:TRok">
						<xsd:minInclusive value="2025"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="kusex:TKodUS1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT-36L"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TIdentyfikatorOsobyFizycznej2">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
				<xsd:element name="NIP" type="etd:TNrNIP">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			<xsd:element name="ImiePierwsze" type="etd:TImie">
				<xsd:annotation>
					<xsd:documentation>Pierwsze imię</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Nazwisko" type="etd:TNazwisko">
				<xsd:annotation>
					<xsd:documentation>Nazwisko</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataUrodzenia">
				<xsd:annotation>
					<xsd:documentation>Data urodzenia</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_10"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TNrIBAN">
		<xsd:annotation>
			<xsd:documentation>Numer IBAN</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{2}[0-9]{2}[0-9A-Z]{10,30}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="SWIFT_Type">
		<xsd:annotation>
			<xsd:documentation>Kod SWIFT</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3}){0,1}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodKrajuWydania">
		<xsd:annotation>
			<xsd:documentation>Kod kraju wydania numeru identyfikacyjnego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="kk:TKodKraju">
			<xsd:pattern value="P[A-KM-Z]"/>
			<xsd:pattern value="[A-OQ-Z][A-Z]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>Zeznanie o wysokości osiągniętego dochodu (poniesionej straty) za rok podatkowy</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="OsobaFizyczna" type="tns:TIdentyfikatorOsobyFizycznej2"/>
						</xsd:sequence>
						<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe, przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 152 - 154 ustawy, dochody / straty ze źródeł przychodów, odliczenia od dochodu, ustalenie podstawy obliczenia podatku / straty, obliczenie podatku, odliczenia od podatku, obliczenie zobowiązania podatkowego, zaliczki, o których mowa w art. 44 ust. 1 pkt 1 ustawy, oraz podatek, o którym mowa w art. 30g ustawy, podatek do zapłaty / nadpłata, zryczałtowany podatek dochodowy, o którym mowa w art. 44 ust. 1b ustawy, odsetki naliczone zgodnie z art. 22e ust. 1 pkt 4 i ust. 2 ustawy, dochody (przychody) wykazywane na podstawie art. 45 ust. 3c ustawy, wniosek o przekazanie 1,5% podatku należnego na rzecz Organizacji Pożytku Publicznego (OPP), dane kontaktowe, informacje o załącznikach, rachunek osobisty do zwrotu nadpłaty, karta dużej rodziny (KDR)</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_7" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta zeznania, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta zeznania, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
								</xsd:annotation>
								<!--Ilekroć jest mowa o Ordynacji podatkowej, oznacza to ustawę z dnia 29 sierpnia 1997 r. – Ordynacja podatkowa.-->
								<!-- -->
								<!--W przypadku wyboru w P_7 wartości 2 korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_11" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Podatnik korzystał w jednym z pięciu lat poprzedzających rok wykazany w poz. 4 ze zwolnienia na podstawie art. 44 ust. 7a ustawy i w roku podatkowym wykazanym w poz. 4 dokonuje doliczenia na podstawie art. 44 ust. 7f ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21">
									<xsd:annotation>
										<xsd:documentation>Rok, w którym podatnik korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2020"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_12" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 26ea ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_13" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik wybrał metodę ustalania daty powstawania przychodów na podstawie art. 14 ust. 1j ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_14" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał metodę ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik rezygnuje ze stosowania metody ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:element name="P_16" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik wybrał prowadzenie ksiąg rachunkowych na podstawie art. 24a ust. 5 ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_17" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał kwartalny sposób wpłacania zaliczek na podstawie art. 44 ust. 3h ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał wpłacanie zaliczek w formie uproszczonej n podstawie art. 44 ust. 6b ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:element name="P_19" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik złożył sprawozdanie o realizacji uprzedniego porozumienia cenowego APA-P</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_20" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał, w roku podatkowym wykazanym w poz. 4, ze zwolnienia na podstawie art. 21 ust. 1 pkt 63b ustawy</xsd:documentation>
								</xsd:annotation>
								<!--W przypadku zaznaczenia kwadratu w poz. 20 należy wypełnić załącznik PIT/SE.-->
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>D. Przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 152 - 154 ustawy</xsd:documentation>
								</xsd:annotation>
								<!--Należy zaznaczyć właściwe kwadraty oraz wykazać przychody objęte zwolnieniami. Suma przychodów zwolnionych od podatku na podstawie art. 21 ust. 1 pkt 148, 152, 153 i 154 ustawy nie może w roku podatkowym przekroczyć kwoty 85 528 zł. Limit ten obejmuje również przychody objęte zwolnieniami na podstawie wskazanych przepisów, które nie są wykazywane w tym zeznaniu. W przypadku zaznaczenia kwadratu w poz. 24 należy do zeznania dołączyć PIT/O z wypełnioną częścią E zawierającą dane co najmniej czworga dzieci uprawniających do ulgi dla rodzin 4+.-->
								<xsd:sequence minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ulga na powrót, o której mowa w art. 21 ust. 1 pkt 152 ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_22" type="etd:TWybor1">
										<xsd:annotation>
											<xsd:documentation>Ulga na powrót, o której mowa w art. 21 ust. 1 pkt 152 ustawy. Wartość: 1 - korzystam z ulgi</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_23" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody objęte zwolnieniem</xsd:documentation>
										</xsd:annotation>
										<xsd:simpleType>
											<xsd:restriction base="etd:TKwota2Nieujemna">
												<xsd:minExclusive value="0"/>
												<xsd:maxInclusive value="85528"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ulga dla rodzin 4+, o której mowa w art. 21 ust. 1 pkt 153 ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_24" type="etd:TWybor1">
										<xsd:annotation>
											<xsd:documentation>Ulga dla rodzin 4+, o której mowa w art. 21 ust. 1 pkt 153 ustawy. Wartość: 1 - korzystam z ulgi</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_25" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody objęte zwolnieniem</xsd:documentation>
										</xsd:annotation>
										<xsd:simpleType>
											<xsd:restriction base="etd:TKwota2Nieujemna">
												<xsd:minExclusive value="0"/>
												<xsd:maxInclusive value="85528"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ulga dla pracujących seniorów, o której mowa w art. 21 ust. 1 pkt 154 ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_26" type="etd:TWybor1">
										<xsd:annotation>
											<xsd:documentation>Ulga dla pracujących seniorów, o której mowa w art. 21 ust. 1 pkt 154 ustawy. Wartość: 1 - korzystam z ulgi</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_27" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Przychody objęte zwolnieniem</xsd:documentation>
										</xsd:annotation>
										<xsd:simpleType>
											<xsd:restriction base="etd:TKwota2Nieujemna">
												<xsd:minExclusive value="0"/>
												<xsd:maxInclusive value="85528"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<!--E. Dochody / straty ze źródeł przychodów-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>1. Pozarolnicza działalność gospodarcza</xsd:documentation>
								</xsd:annotation>
								<!--Sposób obliczenia dochodu (straty) z pozarolniczej działalności gospodarczej nie ma zastosowania do podatników, którzy zaznaczyli kwadrat w poz. 11 (wypełniają załącznik PIT/Z) lub doliczają dochód z kwalifikowanych praw własności intelektualnej niepodlegający opodatkowaniu na podstawie art. 30ca ust. 1 ustawy, tj. według stawki 5%.-->
								<!-- -->
								<!--W poz. 28 i 29 nie wykazuje się przychodu i kosztów uzyskania przychodu, które podatnik wykazuje w załączniku PIT/IP lub PIT/SE.-->
								<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_31" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>2. Działy specjalne produkcji rolnej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_36" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_37" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--F. Odliczenia od dochodu.
Suma odliczeń nie może przekroczyć dochodu z poz. 30 i 35, z tym, że suma odliczeń wykazanych w poz. 43-49 nie może przekroczyć dochodu z poz. 30.-->
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_38" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Straty z lat ubiegłych (wymienić źródła)</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Straty z lat ubiegłych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_40" type="etd:TKwota2Nieujemna" minOccurs="0">
