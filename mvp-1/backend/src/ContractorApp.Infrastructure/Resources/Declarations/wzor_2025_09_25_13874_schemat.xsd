									<xsd:documentation>Strata z pozarolniczej działalności gospodarczej po zmniejszeniach</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_56" type="etd:TKwota2Nieujemna" minOccurs="0">
