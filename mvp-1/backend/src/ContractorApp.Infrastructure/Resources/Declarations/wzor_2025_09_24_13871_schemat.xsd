								<xsd:element name="P_519" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/IP</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_521" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/SE</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_527" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/Z</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_528" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/MIT</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_529" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/WOT</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_530" type="etd:TWybor1_2" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/PM</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_531" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/NZI</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TNaturalny">
											<xsd:minInclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_518" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/DS</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_520" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników SSE-R</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:sequence>
									<xsd:element name="P_522" type="etd:TWybor1">
										<xsd:annotation>
											<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/D</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_523" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT-2K</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_533" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Załącznik PIT/D dołącza do swojego zeznania: 1 - podatnik, 2 - małżonek</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_534" type="etd:TWybor1_3">
										<xsd:annotation>
											<xsd:documentation>Kod zeznania, do którego został dołączony załącznik PIT/D: 1 - PIT-28, 2 - PIT-36, 3 - PIT-37</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_535" type="etd:TZnakowy" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Identyfikator podatkowy, nazwisko i imię małżonka oraz urząd, do którego został złożony załącznik PIT/D</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:choice>
							<xsd:element name="P_524" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/M</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_525" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/O</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_526" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/ZG</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_532" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników Certyfikat rezydencji</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<!--V. Rachunek osobisty do zwrotu nadpłaty-->
							<!-- -->
							<!-- Jeżeli z zeznania wynika nadpłata, w tej części można wskazać rachunek bankowy lub rachunek w spółdzielczej kasie oszczędnościowo-kredytowej (SKOK), inny niż związany z prowadzoną działalnością gospodarczą, na który ma nastąpić jej zwrot. Podaje się rachunek, którego posiadaczem (współposiadaczem) jest podatnik lub małżonek. Wskazanie rachunku, którego posiadaczem (współposiadaczem) nie jest podatnik, a jest nim małżonek, jest możliwe jedynie w przypadku zaznaczenia w poz. 6 kwadratu nr 2. Wskazany rachunek aktualizuje poprzednio zgłoszony rachunek służący do zwrotu podatku lub nadpłaty osoby wskazanej w poz. 536. Można nie wpisywać rachunku, jeżeli zgłoszony poprzednio jest aktualny.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rachunek osobisty do zwrotu nadpłaty</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:element name="P_536_1" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Osoba zgłaszająca rachunek: 1 - podatnik</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_536_2" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Osoba zgłaszająca rachunek (kwadrat nr 2 można zaznaczyć wyłącznie w przypadku zaznaczenia w poz. 6 kwadratu nr 2): 1 - małżonek</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:element name="P_537A" type="tns:TKodKrajuWydania">
										<xsd:annotation>
											<xsd:documentation>Kraj siedziby banku (oddziału)</xsd:documentation>
										</xsd:annotation>
										<!--uzupełnić wyłącznie, gdy wskazano rachunek zagraniczny-->
									</xsd:element>
									<xsd:element name="P_539_2" type="tns:SWIFT_Type">
										<xsd:annotation>
											<xsd:documentation>Kod SWIFT</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku rachunku zagranicznego należy podać kod SWIFT-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_538" type="kw:TKodWaluty" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Waluta, w której prowadzony jest rachunek</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_539_1" type="tns:TNrIBAN">
									<xsd:annotation>
										<xsd:documentation>Pełny numer rachunku - numer IBAN</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--W. Karta Dużej Rodziny (KDR)-->
							<!-- -->
							<!--Wypełnienie poz. 540 nie jest obowiązkowe.-->
							<xsd:element name="P_540_1" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Osoba posiadająca ważną KDR: 1 - podatnik</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_540_2" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Osoba posiadająca ważną KDR (kwadrat nr 2 można zaznaczyć wyłącznie w przypadku zaznaczenia w poz. 6 kwadratu nr 2): 1 - małżonek</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Oswiadczenie">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższego oświadczenia:
W przypadku zastosowania art. 6 ust. 2a ustawy, oświadczam pod rygorem odpowiedzialności karnej za fałszywe zeznania, że jest spełniony warunek przewidziany w tym przepisie.</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
W przypadku niewpłacenia w obowiązujących terminach należnościz poz. 433 albo 434 i 437–484 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, w tym również na odsetki od należności wykazanych w poz. 310-339, 341-346, 348-353, 355-360, 362-391, 393-398, 400-405, 407-412 i 485-508, zgodnie z art. 3a § 1 pkt 1 ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji.

Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:sequence minOccurs="0">
								<xsd:element ref="zb36:Zalacznik_PIT_B" maxOccurs="2"/>
								<xsd:element ref="zbr36:Zalacznik_PIT_BR" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zip36:Zalacznik_PIT_IP" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zse36:Zalacznik_PIT_SE" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="z36:Zalacznik_PIT_Z" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zmt36:Zalacznik_PIT_MIT" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zwt:Zalacznik_PIT_WOT" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zpm36:Zalacznik_PIT_PM" minOccurs="0" maxOccurs="2"/>
								<xsd:element ref="zzi36:Zalacznik_PIT_NZI" minOccurs="0" maxOccurs="unbounded"/>
							</xsd:sequence>
							<xsd:element ref="zds36:Zalacznik_PIT_DS" minOccurs="0" maxOccurs="2"/>
							<xsd:element ref="ssr:Zalacznik_SSE-R" minOccurs="0" maxOccurs="2"/>
							<xsd:sequence minOccurs="0">
								<xsd:element ref="zd:Zalacznik_PIT_D"/>
								<xsd:element ref="z2k:Zalacznik_PIT-2K" minOccurs="0"/>
							</xsd:sequence>
							<xsd:element ref="zm:Zalacznik_PIT_M" minOccurs="0" maxOccurs="2"/>
							<xsd:element ref="zo3x:Zalacznik_PIT_O" minOccurs="0"/>
							<xsd:element ref="zg36:Zalacznik_PIT_ZG" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP_PESEL">
			<xsd:selector xpath="tns:Podmiot1|tns:Podmiot2"/>
			<xsd:field xpath="etd:OsobaFizyczna/etd:NIP|etd:OsobaFizyczna/etd:PESEL|tns:OsobaFizyczna/etd:NIP|tns:OsobaFizyczna/etd:PESEL"/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>