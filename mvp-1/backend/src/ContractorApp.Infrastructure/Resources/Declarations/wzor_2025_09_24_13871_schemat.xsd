							<!--W poz. 516–532 należy podać liczbę załączników. Poz. 533 i 534 wypełniają podatnicy, którzy załącznik PIT/D dołączyli do innego niż składane zeznanie. Jeśli w poz. 533 zaznaczono kwadrat nr 2, należy wypełnić poz. 535.-->
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_516" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/B</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_517" type="etd:TWybor1_2" minOccurs="0">
