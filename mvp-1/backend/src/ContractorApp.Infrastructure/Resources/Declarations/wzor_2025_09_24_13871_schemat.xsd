<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" xmlns:kusex="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/" xmlns:kw="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/" xmlns:ssr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/SSER/" xmlns:zwt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/" xmlns:tns="http://crd.gov.pl/wzor/2025/09/24/13871/" xmlns:zb36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36/" xmlns:zbr36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITBR36/" xmlns:zd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PITD/" xmlns:zds36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITDS36/" xmlns:zg36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZG36/" xmlns:zip36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITIP36/" xmlns:zm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITM/" xmlns:zmt36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITMIT36/" xmlns:zo3x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO3X/" xmlns:zpm36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITPM36/" xmlns:zse36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITSE36/" xmlns:zzi36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITNZI36/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/" xmlns:z2k="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PIT2K/" xmlns:z36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZ36/" targetNamespace="http://crd.gov.pl/wzor/2025/09/24/13871/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITB36/PIT_B(22)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITBR36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITBR36/PIT_BR(7)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITDS36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITDS36/PIT_DS(6)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITIP36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITIP36/PIT_IP(5)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/SSER/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/SSER/SSE-R(5)_Z_v10-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/09/02/eD/PITWOT/PIT_WOT(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO3X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/08/27/eD/PITO3X/PIT_O(30)_Z3X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PITD/PIT_D(31)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PIT2K/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/23/eD/PIT2K/PIT-2K(9)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITSE36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITSE36/PIT_SE(4)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITM/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITM/PIT_M(10)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZG36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZG36/PIT_ZG(8)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZ36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITZ36/PIT_Z(11)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITMIT36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITMIT36/PIT_MIT(2)_Z36_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITPM36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITPM36/PIT_PM(1)_Z36_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITNZI36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/10/30/eD/PITNZI36/PIT_NZI(1)_Z36_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/ORDZU/ORD-ZU(3)_v10-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/12/23/eD/KodyUrzedowSkarbowychExWUS/KodyUrzedowSkarbowychExWUS_v8-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/KodyKrajow_v13-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/04/eD/KodyWalut/KodyWalut_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Formularz przeznaczony jest dla podatników, do których ma zastosowanie art. 45 ust. 1 ustawy z dnia 26 lipca 1991 r. o podatku dochodowym od osób fizycznych zwanej dalej ”ustawą”, a osiągnięte przez nich dochody (poniesione straty) oraz dokonywane odliczenia nie mieszczą się w zakresie zeznania PIT-37.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT-36 (32)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="PIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="32"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_10"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Rok">
				<xsd:simpleType>
					<xsd:restriction base="etd:TRok">
						<xsd:minInclusive value="2025"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="kusex:TKodUS1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT-36"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TWyborSposobu">
		<xsd:annotation>
			<xsd:documentation>Wybór sposobu rozliczenia podatku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:byte">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>indywidualnie</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>wspólnie z małżonkiem, zgodnie z wnioskiem, o którym mowa w art. 6 ust. 2 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>w sposób przewidziany dla wdów i wdowców</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation>w sposób przewidziany dla osób samotnie wychowujących dzieci</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodPocztowy">
		<xsd:annotation>
			<xsd:documentation>Kod pocztowy</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="((\d{2})-(\d{3}))"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TAdres">
		<xsd:annotation>
			<xsd:documentation>Dane określające adres</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:sequence>
				<xsd:element name="AdresPol" type="tns:TAdresPolski"/>
			</xsd:sequence>
			<xsd:sequence>
				<xsd:element name="AdresZagr" type="tns:TAdresZagraniczny"/>
			</xsd:sequence>
		</xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="TAdresPolski">
		<xsd:annotation>
			<xsd:documentation>Informacje opisujące adres polski</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="kk:TKodKraju">
						<xsd:enumeration value="PL"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Wojewodztwo" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Województwo</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Powiat" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Powiat</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Gmina" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Gmina</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Ulica" type="etd:TUlica" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Ulica</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrDomu" type="etd:TNrBudynku">
				<xsd:annotation>
					<xsd:documentation>Nr domu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrLokalu" type="etd:TNrLokalu" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nr lokalu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Miejscowosc" type="etd:TMiejscowosc">
				<xsd:annotation>
					<xsd:documentation>Miejscowość</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KodPocztowy" type="tns:TKodPocztowy">
				<xsd:annotation>
					<xsd:documentation>Kod pocztowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TAdresZagraniczny">
		<xsd:annotation>
			<xsd:documentation>Informacje opisujące adres zagraniczny</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="kk:TKodKraju">
						<xsd:pattern value="P[A-KM-Z]"/>
						<xsd:pattern value="[A-OQ-Z][A-Z]"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodPocztowy" type="etd:TKodPocztowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Kod pocztowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Miejscowosc" type="etd:TMiejscowosc">
				<xsd:annotation>
					<xsd:documentation>Miejscowość</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Ulica" type="etd:TUlica" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Ulica</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrDomu" type="etd:TNrBudynku" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nr domu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrLokalu" type="etd:TNrLokalu" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nr lokalu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaFizyczna3">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaFizyczna" type="tns:TIdentyfikatorOsobyFizycznej3"/>
			<xsd:element name="AdresZamieszkania">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="tns:TAdres">
							<xsd:attribute name="rodzajAdresu" type="xsd:string" use="required" fixed="RAD"/>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaFizyczna1">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaFizyczna" type="tns:TIdentyfikatorOsobyFizycznej1"/>
			<xsd:element name="AdresZamieszkania" minOccurs="0">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="tns:TAdres">
							<xsd:attribute name="rodzajAdresu" type="xsd:string" use="required" fixed="RAD"/>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TIdentyfikatorOsobyFizycznej1">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="NIP" type="etd:TNrNIP">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="PESEL" type="etd:TNrPESEL">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy numer PESEL</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="ImiePierwsze" type="etd:TImie">
				<xsd:annotation>
					<xsd:documentation>Pierwsze imię</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Nazwisko" type="etd:TNazwisko">
				<xsd:annotation>
					<xsd:documentation>Nazwisko</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataUrodzenia">
				<xsd:annotation>
					<xsd:documentation>Data urodzenia</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_26"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TIdentyfikatorOsobyFizycznej3">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="NIP" type="etd:TNrNIP">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="PESEL" type="etd:TNrPESEL">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy numer PESEL</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="ImiePierwsze" type="etd:TImie">
				<xsd:annotation>
					<xsd:documentation>Pierwsze imię</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Nazwisko" type="etd:TNazwisko">
				<xsd:annotation>
					<xsd:documentation>Nazwisko</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataUrodzenia">
				<xsd:annotation>
					<xsd:documentation>Data urodzenia</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_14"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodKrajuWydania">
		<xsd:annotation>
			<xsd:documentation>Kod kraju wydania numeru identyfikacyjnego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="kk:TKodKraju">
			<xsd:pattern value="P[A-KM-Z]"/>
			<xsd:pattern value="[A-OQ-Z][A-Z]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="SWIFT_Type">
		<xsd:annotation>
			<xsd:documentation>Kod SWIFT</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3}){0,1}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNrIBAN">
		<xsd:annotation>
			<xsd:documentation>Numer IBAN</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{2}[0-9]{2}[0-9A-Z]{10,30}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) za rok podatkowy</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne i aktualny adres zamieszkania</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="tns:TOsobaFizyczna3">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne i aktualny adres zamieszkania</xsd:documentation>
					</xsd:annotation>
					<!--Można nie podawać adresu zamieszkania małżonka, jeżeli w poz. 6 zaznaczono kwadrat nr 2 i adres małżonka jest taki sam jak adres zamieszkania podatnika. Adresu małżonka nie podaje się, jeżeli w poz. 6 zaznaczono kwadrat nr 3.-->
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="tns:TOsobaFizyczna1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Małżonek"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe, przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 148, 152, 153 i 154 ustawy, dochody / straty ze źródeł przychodów, odliczenie strat i składek na ubezpieczenia społeczne, odliczenia od dochodu / zwolnienie, ustalenie podstawy obliczenia podatku / straty, obliczenie podatku, odliczenia od podatku, obliczenie zobowiązania podatkowego, zaliczki, o których mowa w art. 44 ust. 1 ustawy, oraz podatek, o którym mowa w art. 30g ustawy, dodatkowy zwrot z tytułu ulgi na dzieci, podatek do zapłaty / nadpłata / łączny zwrot, zryczałtowany podatek dochodowy, o którym mowa w art. 44 ust. 1b ustawy, odsetki naliczone zgodnie z art. 22e ust. 1 pkt 4 i ust. 2 ustawy, należne zaliczki, o których mowa w art. 44 ust. 1a, 1c i 7 ustawy, dochody (przychody) wykazywane na podstawie art. 45 ust. 3c ustawy, wniosek o przekazanie 1,5% podatku należnego na rzecz Organizacji Pożytku Publicznego (OPP), dane kontaktowe, informacje o załącznikach, rachunek osobisty do zwrotu nadpłaty, KDR</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence>
								<!--Zaznaczenie odpowiednich kwadratów traktuje się na równi ze złożeniem wniosku o zastosowanie wskazanego sposobu rozliczenia podatku. Kwadrat w poz. 7 lub 8 zaznacza się łącznie z kwadratem 1, 2, 3 albo 4 w poz. 6.-->
								<xsd:element name="P_6" type="tns:TWyborSposobu">
									<xsd:annotation>
										<xsd:documentation>Wybór sposobu rozliczenia podatku: 1 - indywidualnie, 2 - wspólnie z małżonkiem, zgodnie z wnioskiem, o którym mowa w art. 6 ust. 2 ustawy, 3 - w sposób przewidziany dla wdów i wdowców, 4 - w sposób przewidziany dla osób samotnie wychowujących dzieci</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_7" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wybór sposobu rozliczenia podatku: 1 - w sposób przewidziany w art. 29 ust. 4 ustawy - podatnik</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wybór sposobu rozliczenia podatku: 1 - w sposób przewidziany w art. 29 ust. 4 ustawy - małżonek</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_11" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta zeznania, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta zeznania, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
								</xsd:annotation>
								<!--Ilekroć jest mowa o Ordynacji podatkowej, oznacza to ustawę z dnia 29 sierpnia 1997 r. – Ordynacja podatkowa.-->
								<!-- -->
								<!--W przypadku zaznaczenia w poz. 11 kwadratu nr 2 korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
							</xsd:element>
							<!--C. Informacje dodatkowe-->
							<!-- -->
							<!--Należy zaznaczyć właściwe kwadraty. W przypadku zaznaczenia kwadratu w poz. 42 lub 43 należy wypełnić załącznik PIT/SE.-->
							<xsd:element name="P_36" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_37" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_38" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Podatnik korzystał, w jednym z pięciu lat poprzedzających rok wykazany w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy i w roku podatkowym wykazanym w poz. 5 dokonuje doliczenia na podstawie art. 44 ust. 7f ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--Poz. 58 wypełniają podatnicy, którzy zaznaczyli kwadrat w poz. 38 lub 39.-->
								<xsd:element name="P_58_1">
									<xsd:annotation>
										<xsd:documentation>Rok (podać rok, w którym podatnik korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2020"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_39" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Małżonek korzystał, w jednym z pięciu lat poprzedzających rok wykazany w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy i w roku podatkowym wykazanym w poz. 5 dokonuje doliczenia na podstawie art. 44 ust. 7f ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--Poz. 58 wypełniają podatnicy, którzy zaznaczyli kwadrat w poz. 38 lub 39.-->
								<xsd:element name="P_58_2">
									<xsd:annotation>
										<xsd:documentation>Rok (podać rok, w którym małżonek korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2020"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_40" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 26ea ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_41" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek występuje o zwrot niewykorzystanego odliczenia na podstawie art. 26ea ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_42" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 21 ust. 1 pkt 63a lub 63b ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_43" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 21 ust. 1 pkt 63a lub 63b ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_44" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik wybrał metodę ustalania daty powstawania przychodów na podstawie art. 14 ust. 1j ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_45" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek wybrał metodę ustalania daty powstawania przychodów na podstawie art. 14 ust. 1j ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_46" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał metodę ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_48" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik rezygnuje ze stosowania metody ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_47" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek wybrał metodę ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_49" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek rezygnuje ze stosowania metody ustalania różnic kursowych, o której mowa w art. 14b ust. 2 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:element name="P_50" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik wybrał prowadzenie ksiąg rachunkowych, na podstawie art. 24a ust. 5 ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_51" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek wybrał prowadzenie ksiąg rachunkowych, na podstawie art. 24a ust. 5 ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_52" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał kwartalny sposób wpłacania zaliczek na podstawie art. 44 ust. 3g ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_54" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał wpłacanie zaliczek w formie uproszczonej na podstawie art. 44 ust. 6b ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:choice minOccurs="0">
								<xsd:element name="P_53" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek wybrał kwartalny sposób wpłacania zaliczek na podstawie art. 44 ust. 3g ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_55" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek wybrał wpłacanie zaliczek w formie uproszczonej na podstawie art. 44 ust. 6b ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:choice>
							<xsd:element name="P_56" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik złożył sprawozdanie o realizacji uprzedniego porozumienia cenowego APA-P</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_57" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek złożył sprawozdanie o realizacji uprzedniego porozumienia cenowego APA-P</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--D. Przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 148, 152, 153 i 154 ustawy-->
							<!-- -->
							<!--Należy zaznaczyć właściwe kwadraty oraz wykazać przychody objęte zwolnieniami. Suma przychodów zwolnionych od podatku na podstawie art. 21 ust. 1 pkt 148, 152, 153 i 154 ustawy nie może w roku podatkowym przekroczyć kwoty 85 528 zł. Limit ten przysługuje odrębnie podatnikowi i małżonkowi oraz obejmuje również przychody objęte zwolnieniami na podstawie wskazanych przepisów, które nie są wykazywane w tym zeznaniu. W przypadku zaznaczenia kwadratu w poz. 63 lub 64 należy do zeznania dołączyć PIT/O z wypełnioną częścią E zawierającą dane co najmniej czworga dzieci uprawniających do ulgi dla rodzin 4+.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 148, 152, 153 i 154 ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence minOccurs="0">
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Rodzaj zwolnienia - podatnik</xsd:documentation>
										</xsd:annotation>
										<xsd:choice minOccurs="0">
											<xsd:sequence>
												<xsd:element name="P_59" type="etd:TWybor1">
													<xsd:annotation>
														<xsd:documentation>Podatnik - Ulga dla młodych, o której mowa w art. 21 ust. 1 pkt 148 ustawy</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_71" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Podatnik - Przychody z praktyk absolwenckich i staży uczniowskich</xsd:documentation>
													</xsd:annotation>
													<xsd:simpleType>
														<xsd:restriction base="etd:TKwota2Nieujemna">
															<xsd:maxInclusive value="85528"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:element>
											</xsd:sequence>
											<xsd:element name="P_65" type="etd:TWybor1" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Podatnik - Ulga dla pracujących seniorów, o której mowa w art. 21 ust. 1 pkt 154 ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:choice>
										<xsd:element name="P_61" type="etd:TWybor1" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Ulga na powrót, o której mowa w art. 21 ust. 1 pkt 152 ustawy</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_63" type="etd:TWybor1" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Ulga dla rodzin 4+, o której mowa w art. 21 ust. 1 pkt 153 ustawy</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Rodzaj przychodów - podatnik</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_67" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Przychody ze stosunku służbowego, stosunku pracy, pracy nakładczej, spółdzielczego stosunku pracy</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:maxInclusive value="85528"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_69" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Przychody z umów zlecenia, o których mowa w art. 13 pkt 8 ustawy</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:maxInclusive value="85528"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_73" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Przychody z zasiłku macierzyńskiego</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:maxInclusive value="85528"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_75" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Podatnik - Przychody z pozarolniczej działalności gospodarczej</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:maxInclusive value="85528"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
									</xsd:sequence>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Rodzaj zwolnienia - małżonek</xsd:documentation>
										</xsd:annotation>
										<xsd:choice minOccurs="0">
											<xsd:sequence>
												<xsd:element name="P_60" type="etd:TWybor1">
													<xsd:annotation>
														<xsd:documentation>Małżonek - Ulga dla młodych, o której mowa w art. 21 ust. 1 pkt 148 ustawy</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_72" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Małżonek - Przychody z praktyk absolwenckich i staży uczniowskich</xsd:documentation>
													</xsd:annotation>
													<xsd:simpleType>
														<xsd:restriction base="etd:TKwota2Nieujemna">
															<xsd:maxInclusive value="85528"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:element>
											</xsd:sequence>
											<xsd:element name="P_66" type="etd:TWybor1" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Małżonek - Ulga dla pracujących seniorów, o której mowa w art. 21 ust. 1 pkt 154 ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:choice>
										<xsd:element name="P_62" type="etd:TWybor1" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Małżonek - Ulga na powrót, o której mowa w art. 21 ust. 1 pkt 152 ustawy</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_64" type="etd:TWybor1" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Małżonek - Ulga dla rodzin 4+, o której mowa w art. 21 ust. 1 pkt 153 ustawy</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
