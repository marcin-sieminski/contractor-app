									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:fractionDigits value="1"/>
										</xsd:restriction>
									</xsd:simpleType>
									<!--Kwota z poz. 511 nie może przekroczyć 1,5% kwoty z poz. 306 po zaokrągleniu do pełnych dziesiątek groszy w dół.-->
								</xsd:element>
								<xsd:element name="P_512" type="etd:TZnakowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Cel szczegółowy 1,5%</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_513" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wyrażam zgodę na przekazanie OPP swojego imienia, nazwiska i adresu wraz z informacją o kwocie z poz. 501</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--T. Dane kontaktowe-->
