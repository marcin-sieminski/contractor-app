							<!--Pozycje dotyczące należnych zaliczek oraz zapłaconych zaliczek wypełniają również podatnicy, o których mowa w art. 44 ust. 14 ustawy.-->
							<!-- -->
							<!--L.1. Zaliczki, o których mowa w art. 44 ust. 1 ustawy, oraz podatek, o którym mowa w art. 30g ustawy – podatnik-->
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_310" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należna zaliczka za miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_316" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należny podatek, o którym mowa w art. 30g ustawy za miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_322" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Zapłacony podatek, o którym mowa w art. 30g ustawy za miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_328" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Zapłacona zaliczka za miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_311" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należna zaliczka za miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_317" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należny podatek, o którym mowa w art. 30g ustawy za miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_323" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Zapłacony podatek, o którym mowa w art. 30g ustawy za miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_329" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Zapłacona zaliczka za miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_312" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należna zaliczka za miesiąc III / I kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_318" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Należny podatek, o którym mowa w art. 30g ustawy za miesiąc III / I kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
